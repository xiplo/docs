# === Nano Banana (Image Generation) ===
NANO_BANANA_API_KEY=your_nano_banana_api_key
NANO_BANANA_BASE_URL=https://api.nanobanana.com/v1

# === Kling 3.0 / KIE (Video Generation) ===
KLING_API_KEY=your_kling_api_key
KLING_BASE_URL=https://api.klingai.com/v1

# === Eleven Labs (Uzbek TTS) ===
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_uzbek_voice_id

# === Instagram Graph API ===
INSTAGRAM_ACCESS_TOKEN=your_long_lived_access_token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_business_account_id

# === General ===
CONTENT_OUTPUT_DIR=./output
LOG_LEVEL=INFO
POST_SCHEDULE_CRON=0 9,13,18 * * *
TIMEZONE=Asia/Tashkent
