# === AI Content Generation (Claude) ===
ANTHROPIC_API_KEY=                                  # Claude claude-sonnet-4-6 for captions, scripts, reviews, translations
CLAUDE_MODEL=claude-sonnet-4-6-20250514                    # Model ID (default: claude-sonnet-4-6)

# === PiAPI (Unified AI Gateway — PRIMARY) ===
PIAPI_API_KEY=                                      # piapi.ai — Flux images, Kling video, Seedance, Veo3

# === Nano Banana (Image Generation — LEGACY FALLBACK) ===
NANO_BANANA_API_KEY=your_nano_banana_api_key
NANO_BANANA_BASE_URL=https://api.nanobanana.com/v1

# === Kling 3.0 / KIE (Video Generation) ===
KLING_API_KEY=your_kling_api_key
KLING_BASE_URL=https://api.klingai.com/v1

# === Eleven Labs (Uzbek TTS) ===
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_uzbek_voice_id

# === Instagram Graph API ===
INSTAGRAM_ACCESS_TOKEN=your_long_lived_access_token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_business_account_id

# === CDN / S3 Storage ===
CDN_PROVIDER=s3                                    # s3, r2, minio, http
CDN_BUCKET_NAME=your-instagram-assets
CDN_REGION=us-east-1
CDN_ENDPOINT_URL=                                  # For R2: https://<account>.r2.cloudflarestorage.com
CDN_PUBLIC_URL=https://cdn.yourdomain.com           # Public base URL
CDN_UPLOAD_URL=                                     # For http provider only
CDN_API_KEY=                                        # For http provider only
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret

# === Notifications ===
TELEGRAM_BOT_TOKEN=                                 # Telegram Bot API token
TELEGRAM_CHAT_ID=                                   # Chat/channel ID for notifications
NOTIFY_WEBHOOK_URL=                                 # Slack/Discord webhook URL

# === Content Queue ===
QUEUE_ENABLED=true
QUEUE_MAX_SIZE=50
QUEUE_FILE=content_queue.json

# === A/B Testing ===
AB_TESTING_ENABLED=false
AB_VARIANT_COUNT=2

# === Webhook ===
WEBHOOK_PORT=8080
WEBHOOK_SECRET=your_webhook_verify_token
WEBHOOK_API_KEY=                                    # API key for non-Instagram endpoints (Bearer/X-API-Key)

# === Logging ===
LOG_LEVEL=INFO
LOG_FORMAT=                                         # Set to "json" for production

# === Twitter/X ===
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# === TikTok ===
TIKTOK_ACCESS_TOKEN=

# === YouTube ===
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_API_KEY=

# === Facebook Pages ===
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# === Telegram Channel ===
TELEGRAM_CHANNEL_BOT_TOKEN=                         # Bot token for channel posting
TELEGRAM_CHANNEL_ID=                                # Channel ID (e.g. @mychannel or -100xxx)

# === LinkedIn ===
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=                           # For company pages
LINKEDIN_PERSON_ID=                                 # For personal profiles

# === Pinterest ===
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# === Threads ===
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# === General ===
CONTENT_OUTPUT_DIR=./output
POST_SCHEDULE_CRON=0 9,13,18 * * *
TIMEZONE=Asia/Tashkent
